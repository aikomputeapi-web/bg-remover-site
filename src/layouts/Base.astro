---
import "@/styles/global.css";
const { title = "Free Background Remover - Remove Image Backgrounds Online", description = "Remove image backgrounds free in your browser. 100% private, no signup, no upload, AI-powered transparent PNGs in seconds." } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url.pathname} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{title}</title>
  </head>
  <body class="bg-slate-950 text-slate-100 antialiased min-h-screen flex flex-col">
    <header class="border-b border-slate-800">
      <nav class="max-w-5xl mx-auto px-4 py-4 flex items-center justify-between">
        <a href="/" class="font-bold text-lg bg-gradient-to-r from-fuchsia-400 to-cyan-400 bg-clip-text text-transparent">FreeBG</a>
        <div class="flex gap-6 text-sm text-slate-300">
          <a href="/" class="hover:text-white">Tool</a>
          <a href="/blog/" class="hover:text-white">Blog</a>
        </div>
      </nav>
    </header>
    <main class="flex-1">
      <slot />
    </main>
    <footer class="border-t border-slate-800 mt-16">
      <div class="max-w-5xl mx-auto px-4 py-8 text-sm text-slate-400 flex flex-col sm:flex-row gap-4 justify-between">
        <p>FreeBG - free private in-browser background remover.</p>
        <p>Runs 100% in your browser. No uploads. No accounts.</p>
      </div>
    </footer>
  </body>
</html>
